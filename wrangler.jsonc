{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tcg-pack-opener",
	"compatibility_date": "2026-09-21",
	// The API (accounts and collection sync). Everything outside /api/ is served straight from the built app.
	"main": "worker/index.ts",
	"observability": {
		"enabled": true
	},
	// Games switched on besides Pokémon, as comma-separated game ids (src/game.ts; worker/games.ts). Magic: The Gathering
	// is live. A game still in the works stays out of this list, and goes in .dev.vars to work on it locally.
	"vars": {
		"DEMO_GAMES": "mtg"
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tcg",
			"database_id": "a089ed41-7c13-4624-ba5d-f8ad1ab4690d",
			"migrations_dir": "migrations"
		}
	],
	// Yu-Gi-Oh! card images, downloaded once from YGOPRODeck (which asks not to be hotlinked) and served from here
	// (worker/ygo.ts). Create it before the first deploy: `npx wrangler r2 bucket create tcg-ygo-images`.
	"r2_buckets": [
		{
			"binding": "YGO_IMAGES",
			"bucket_name": "tcg-ygo-images"
		}
	],
	// Slows password guessing: sign-in, sign-up and password changes, per IP.
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		// Guest accounts per IP, so packs can't be farmed by clearing cookies over and over. Roomy enough for a group
		// of friends on the same Wi-Fi all opening the app at once.
		{
			"name": "GUEST_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		// Requests to YGOPRODeck, which blocks an IP for an hour past 20 a second. Everything fetched is kept
		// (worker/ygo.ts), so most are one-offs: card data (a set at a time, rarely)…
		{
			"name": "YGOPRODECK_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 15,
				"period": 10
			}
		},
		// …and card images, which come in bursts the first time anyone opens a set's binder (a hundred at once).
		{
			"name": "YGO_IMAGE_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 150,
				"period": 10
			}
		},
		// Friend requests per account, so friend codes can't be guessed by trying them all.
		{
			"name": "FRIEND_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
	// GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are secrets (`npx wrangler secret put ...`, or .dev.vars locally).
	// Without them Google sign-in is hidden and email/password still works.
}