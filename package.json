{
  "name": "tcg-pack-opener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply tcg --local",
    "rarities": "tsx scripts/rarities.ts",
    "simulate": "tsx scripts/simulate.ts",
    "open": "tsx scripts/open.ts",
    "pokedex": "tsx scripts/pokedex.ts",
    "set-rarity": "tsx scripts/setRarity.ts",
    "deploy": "npm run build && wrangler d1 migrations apply tcg --remote && wrangler deploy",
    "pack-art": "tsx scripts/packArt.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
